{
  "compilerOptions": {
    "target": "ES2020",
     "module": "CommonJS",             // <-- Important for ES Modules
    "moduleResolution": "node",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node", "jest"]
  }
}
